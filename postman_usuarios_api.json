                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 88888\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/eliminar",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "eliminar"]
            },
            "description": "Responde 404 con formato uniforme GenericResponse."
          },
          "response": []
        }
      ]
    }
  ]
}
